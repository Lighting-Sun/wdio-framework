{
    "name": "webdriver-io-framework",
    "version": "1.0.0",
    "description": "wdio automation test framework",
    "type": "module",
    "scripts": {
        "test": "wdio run ./wdio.conf.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate-allure-report": "allure generate --clean ./reports/allure/allure-results -o ./reports/allure/allure-report && allure open ./reports/allure/allure-report",
        "open-allure": "allure open ./reports/allure/allure-report"
    },
    "author": "Harvey Cortes",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@wdio/allure-reporter": "^9.27.0",
        "@wdio/cli": "^9.27.0",
        "@wdio/local-runner": "^9.27.0",
        "@wdio/mocha-framework": "^9.27.0",
        "@wdio/spec-reporter": "^9.27.0",
        "allure-commandline": "^2.38.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-wdio": "^9.31.3",
        "prettier": "^3.9.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "yargs": "^18.0.0"
    },
    "engines": {
        "node": ">=20.17.0"
    }
}
